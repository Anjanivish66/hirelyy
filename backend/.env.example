# Copy this file to .env and fill in your own values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=HIRELYDB

# Server
PORT=5000

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seed / default admin account (used by `npm run seed`)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@hirely.com
ADMIN_PASSWORD=Admin@123
